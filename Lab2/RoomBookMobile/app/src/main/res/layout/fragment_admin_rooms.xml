<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Панель адміністратора"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Форма кімнати (Додати/Редагувати)"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etRoomId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ID Кімнати (тільки для редагування/видалення)"
                    android:inputType="number"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Назва кімнати"
                    android:inputType="text"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etRoomCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Місткість (осіб)"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnAddRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#198754"
                    android:text="СТВОРИТИ КІМНАТУ" />

                <Button
                    android:id="@+id/btnUpdateRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#FFC107"
                    android:textColor="#000000"
                    android:text="ОНОВИТИ КІМНАТУ" />

                <Button
                    android:id="@+id/btnDeleteRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#DC3545"
                    android:text="ВИДАЛИТИ КІМНАТУ" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnRefreshAdminRooms"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оновити список приміщень" />

        <TextView
            android:id="@+id/tvAdminRoomsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textColor="#333333"/>
    </LinearLayout>
</ScrollView>